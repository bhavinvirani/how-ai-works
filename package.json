{
  "name": "how-ai-works",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "An open-source site that teaches AI and machine learning from first principles.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/bhavinvirani/how-ai-works.git"
  },
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24.16.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "preview": "astro preview",
    "check": "astro check && tsc --noEmit -p tsconfig.node.json",
    "lint": "astro sync && eslint . && node scripts/check-raw-colors.mjs",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check . --ignore-path .prettierignore --ignore-path .prettierignore-ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "pnpm build && playwright test",
    "budgets": "pnpm build && node scripts/check-budgets.mjs",
    "icons": "node scripts/make-icons.mjs",
    "new:interactive": "node scripts/new-interactive.mjs",
    "new:unit": "node scripts/new-unit.mjs"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "7.2.2",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/react": "^6.0.2",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/public-sans": "^5.3.0",
    "@nanostores/persistent": "^1.3.5",
    "@nanostores/react": "^1.1.0",
    "@xyflow/react": "^12.11.2",
    "astro": "^7.1.6",
    "katex": "^0.18.1",
    "nanostores": "^1.4.2",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/estree": "^1.0.9",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.0",
    "eslint-plugin-astro": "^3.0.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.8.0",
    "jsdom": "^30.0.1",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "^4.1.10"
  }
}
