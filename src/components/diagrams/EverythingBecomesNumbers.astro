---
/**
 * Three things a person would never call data, and what each one already is
 * underneath: a picture, a sound, and a word.
 *
 * The point of the arrangement is the third row breaking the pattern. Rows one
 * and two arrive as numbers with no effort at all — the conversion happened in
 * the camera and the microphone. Row three has a question mark where the
 * numbers should be, and that gap is what the language half of this site
 * exists to fill.
 *
 * The gap is marked by a "?", a dashed edge and a sentence, so the accent
 * colour is never the only signal (hard rule 9). Decorative on its own, so
 * `aria-hidden`: `Figure` supplies the accessible name and the description.
 */
---

<svg viewBox="0 0 640 280" class="w-full" aria-hidden="true">
  <!-- ================= a photograph ================= -->
  <text
    x="16"
    y="30"
    class="fill-ink font-display"
    font-size="11"
    font-weight="700">a photograph</text
  >

  <g class="stroke-rule" stroke-width="1">
    <rect x="16" y="38" width="24" height="24" class="fill-paper-sunken"></rect>
    <rect x="40" y="38" width="24" height="24" class="fill-rule"></rect>
    <rect x="64" y="38" width="24" height="24" class="fill-ink-faint"></rect>
    <rect x="88" y="38" width="24" height="24" class="fill-rule"></rect>

    <rect x="16" y="62" width="24" height="24" class="fill-rule"></rect>
    <rect x="40" y="62" width="24" height="24" class="fill-ink-faint"></rect>
    <rect x="64" y="62" width="24" height="24" class="fill-ink-faint"></rect>
    <rect x="88" y="62" width="24" height="24" class="fill-paper-sunken"></rect>

    <rect x="16" y="86" width="24" height="24" class="fill-paper"></rect>
    <rect x="40" y="86" width="24" height="24" class="fill-rule"></rect>
    <rect x="64" y="86" width="24" height="24" class="fill-paper-sunken"></rect>
    <rect x="88" y="86" width="24" height="24" class="fill-rule"></rect>
  </g>

  <!-- One dot, singled out, so the three numbers beside it have an owner. -->
  <rect
    x="40"
    y="62"
    width="24"
    height="24"
    class="fill-none stroke-accent"
    stroke-width="2.5"></rect>

  <g class="stroke-rule-strong" stroke-width="1.5">
    <line x1="124" y1="74" x2="164" y2="74"></line>
    <path d="M158 69 L166 74 L158 79" class="fill-none"></path>
  </g>

  <text x="180" y="58" class="fill-ink font-mono" font-size="9"
    >already numbers &mdash; one dot is three of them</text
  >

  <g class="stroke-rule" stroke-width="1">
    <rect x="180" y="66" width="68" height="24" class="fill-paper-sunken"
    ></rect>
    <rect x="254" y="66" width="68" height="24" class="fill-paper-sunken"
    ></rect>
    <rect x="328" y="66" width="68" height="24" class="fill-paper-sunken"
    ></rect>
  </g>
  <g class="fill-ink font-mono" font-size="9">
    <text x="214" y="82" text-anchor="middle">red 214</text>
    <text x="288" y="82" text-anchor="middle">green 118</text>
    <text x="362" y="82" text-anchor="middle">blue 61</text>
  </g>
  <text x="404" y="82" class="fill-ink-faint font-mono" font-size="11"
    >&hellip;</text
  >
  <text x="180" y="106" class="fill-ink-faint font-mono" font-size="8"
    >a phone photo holds about thirty-six million of these</text
  >

  <!-- ================= a sound ================= -->
  <text
    x="16"
    y="146"
    class="fill-ink font-display"
    font-size="11"
    font-weight="700">a sound</text
  >

  <path
    d="M16 172 q 8 -20 16 0 t 16 0 t 16 0 t 16 0 t 16 0 t 16 0"
    class="fill-none stroke-ink-muted"
    stroke-width="1.5"></path>

  <g class="stroke-rule-strong" stroke-width="1.5">
    <line x1="124" y1="172" x2="164" y2="172"></line>
    <path d="M158 167 L166 172 L158 177" class="fill-none"></path>
  </g>

  <text x="180" y="160" class="fill-ink font-mono" font-size="9"
    >already numbers &mdash; how hard the air pushed, moment by moment</text
  >

  <g class="stroke-rule" stroke-width="1">
    <rect x="180" y="168" width="54" height="24" class="fill-paper-sunken"
    ></rect>
    <rect x="240" y="168" width="54" height="24" class="fill-paper-sunken"
    ></rect>
    <rect x="300" y="168" width="54" height="24" class="fill-paper-sunken"
    ></rect>
    <rect x="360" y="168" width="54" height="24" class="fill-paper-sunken"
    ></rect>
  </g>
  <g class="fill-ink font-mono" font-size="9">
    <text x="207" y="184" text-anchor="middle">0.12</text>
    <text x="267" y="184" text-anchor="middle">&minus;0.44</text>
    <text x="327" y="184" text-anchor="middle">0.91</text>
    <text x="387" y="184" text-anchor="middle">&minus;0.07</text>
  </g>
  <text x="422" y="184" class="fill-ink-faint font-mono" font-size="11"
    >&hellip;</text
  >
  <text x="442" y="184" class="fill-ink-faint font-mono" font-size="8"
    >forty-four thousand a second</text
  >

  <!-- ================= a word ================= -->
  <text
    x="16"
    y="222"
    class="fill-ink font-display"
    font-size="11"
    font-weight="700">a word</text
  >

  <rect
    x="16"
    y="232"
    width="96"
    height="32"
    rx="4"
    class="fill-paper-sunken stroke-rule-strong"
    stroke-width="1.25"></rect>
  <text
    x="64"
    y="253"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="12">happy</text
  >

  <g class="stroke-rule-strong" stroke-width="1.5">
    <line x1="124" y1="248" x2="164" y2="248"></line>
    <path d="M158 243 L166 248 L158 253" class="fill-none"></path>
  </g>

  <rect
    x="180"
    y="232"
    width="68"
    height="32"
    rx="4"
    class="fill-accent-soft stroke-accent"
    stroke-width="1.75"
    stroke-dasharray="4 3"></rect>
  <text
    x="214"
    y="255"
    text-anchor="middle"
    class="fill-accent font-display"
    font-size="16"
    font-weight="700">?</text
  >

  <text x="260" y="246" class="fill-ink font-mono" font-size="9"
    >no obvious number, and no obvious order to put words in</text
  >
  <text x="260" y="260" class="fill-ink-faint font-mono" font-size="8"
    >this one took decades to solve, and gets its own unit</text
  >
</svg>
