---
/**
 * Three beats: an unlabelled cloud, the piles a machine makes of it, and the
 * names a person writes on those piles afterwards.
 *
 * The teaching load is carried by the dashed wall between the second and third
 * panels — everything to its right came from a human being, and nothing to its
 * left has a name at all. Group membership is drawn as a shape and repeated in
 * words beside each name tag, so nothing here depends on seeing colour (hard
 * rule 9).
 *
 * Decorative on its own, so `aria-hidden`: `Figure` supplies the accessible name
 * and the description.
 */
---

<svg viewBox="0 0 640 274" class="w-full" aria-hidden="true">
  <g class="fill-ink font-display" font-size="13" font-weight="700">
    <text x="24" y="24">What you hand it</text>
    <text x="240" y="24">What comes back</text>
    <text x="460" y="24">What a person adds</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="9">
    <text x="24" y="38">forty-two shoppers, two measurements each</text>
    <text x="240" y="38">the same shoppers, gathered by resemblance</text>
    <text x="460" y="38">none of it came out of the data</text>
  </g>

  <!-- Panel 1: every point identical, because nothing has been marked. -->
  <g class="fill-none stroke-rule-strong" stroke-width="1.2">
    <circle cx="136" cy="168" r="4"></circle>
    <circle cx="149" cy="177" r="4"></circle>
    <circle cx="127" cy="180" r="4"></circle>
    <circle cx="157" cy="163" r="4"></circle>
    <circle cx="141" cy="186" r="4"></circle>
    <circle cx="121" cy="165" r="4"></circle>
    <circle cx="49" cy="85" r="4"></circle>
    <circle cx="58" cy="76" r="4"></circle>
    <circle cx="43" cy="96" r="4"></circle>
    <circle cx="65" cy="91" r="4"></circle>
    <circle cx="52" cy="105" r="4"></circle>
    <circle cx="90" cy="131" r="4"></circle>
    <circle cx="99" cy="122" r="4"></circle>
    <circle cx="80" cy="140" r="4"></circle>
    <circle cx="105" cy="142" r="4"></circle>
    <circle cx="93" cy="148" r="4"></circle>
    <circle cx="115" cy="151" r="4"></circle>
    <circle cx="71" cy="119" r="4"></circle>
  </g>

  <!-- The one move the machine makes. -->
  <g class="fill-none stroke-accent-2" stroke-width="1.75">
    <line x1="186" y1="128" x2="222" y2="128"></line>
    <path d="M216 123 L224 128 L216 133"></path>
  </g>
  <text
    x="204"
    y="119"
    text-anchor="middle"
    class="fill-ink-muted font-mono"
    font-size="8">gathers</text
  >

  <!-- Panel 2: the same cloud, now in three piles with three shapes. -->
  <g class="fill-ink-muted">
    <circle cx="355" cy="168" r="4"></circle>
    <circle cx="368" cy="177" r="4"></circle>
    <circle cx="346" cy="180" r="4"></circle>
    <circle cx="376" cy="163" r="4"></circle>
    <circle cx="360" cy="186" r="4"></circle>
    <circle cx="339" cy="165" r="4"></circle>

    <rect x="262" y="81" width="8" height="8"></rect>
    <rect x="271" y="72" width="8" height="8"></rect>
    <rect x="255" y="92" width="8" height="8"></rect>
    <rect x="278" y="87" width="8" height="8"></rect>
    <rect x="265" y="101" width="8" height="8"></rect>

    <polygon points="307,126 311,134 303,134"></polygon>
    <polygon points="317,117 321,125 313,125"></polygon>
    <polygon points="298,135 302,143 294,143"></polygon>
    <polygon points="323,137 327,145 319,145"></polygon>
    <polygon points="310,143 314,151 306,151"></polygon>
    <polygon points="333,146 337,154 329,154"></polygon>
    <polygon points="288,114 292,122 284,122"></polygon>
  </g>

  <g class="fill-ink font-mono" font-size="9">
    <text x="357" y="204" text-anchor="middle">Group 1</text>
    <text x="270" y="66" text-anchor="middle">Group 2</text>
    <text x="344" y="120">Group 3</text>
  </g>

  <!-- The sentence of the diagram. -->
  <g class="stroke-rule-strong" stroke-width="1.5" stroke-dasharray="4 4">
    <line x1="441" y1="14" x2="441" y2="240"></line>
  </g>
  <text
    x="441"
    y="258"
    text-anchor="middle"
    class="fill-accent font-display"
    font-size="12"
    font-weight="700">the machine stops here</text
  >

  <!-- Panel 3: names, invented afterwards, by a person. -->
  <g
    class="fill-accent-soft stroke-accent"
    stroke-width="1.25"
    stroke-dasharray="4 3"
  >
    <rect x="460" y="60" width="168" height="40" rx="6"></rect>
    <rect x="460" y="112" width="168" height="40" rx="6"></rect>
    <rect x="460" y="164" width="168" height="40" rx="6"></rect>
  </g>

  <g class="fill-ink-muted">
    <circle cx="476" cy="80" r="4"></circle>
    <rect x="472" y="128" width="8" height="8"></rect>
    <polygon points="476,180 480,188 472,188"></polygon>
  </g>

  <g class="fill-ink font-display" font-size="12" font-weight="700">
    <text x="492" y="78">the milk run</text>
    <text x="492" y="130">the weekly big shop</text>
    <text x="492" y="182">the in-betweens</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="8">
    <text x="492" y="91">group 1, named by a person</text>
    <text x="492" y="143">group 2, named by a person</text>
    <text x="492" y="195">group 3, nobody is sure</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="8">
    <text x="24" y="232">no answers, no labels, no names</text>
    <text x="240" y="232">three piles, numbered</text>
  </g>
</svg>
