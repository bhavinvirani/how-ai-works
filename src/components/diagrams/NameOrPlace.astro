---
/**
 * The same three words, twice: numbered by where they fall in a list, and then
 * placed by what they mean.
 *
 * The whole teaching load sits on one comparison. In the list, "cat" and
 * "catapult" are neighbours and "kitten" is three thousand rows away — an
 * arrangement that knows the alphabet and nothing else. On the map, the two
 * words that mean nearly the same thing are the two that are close, and the
 * siege engine is off on its own.
 *
 * Nearness is drawn as distance AND labelled in words AND marked solid against
 * dashed, so no reading of it depends on colour (hard rule 9). Decorative on its
 * own, so `aria-hidden`: `Figure` supplies the accessible name and description.
 */
---

<svg viewBox="0 0 640 276" class="w-full" aria-hidden="true">
  <g class="fill-ink font-display" font-size="13" font-weight="700">
    <text x="16" y="22">A number that is only a name</text>
    <text x="366" y="22">A number that is a place</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="9">
    <text x="16" y="36">every word numbered off in alphabetical order</text>
    <text x="366" y="36">every word given two numbers of its own</text>
  </g>

  <!-- ============ the list ============ -->
  <g class="fill-ink-faint font-mono" font-size="11">
    <text x="86" y="76" text-anchor="end">1,741</text>
    <text x="86" y="102" text-anchor="end">1,742</text>
    <text x="86" y="128" text-anchor="end">1,743</text>
    <text x="86" y="200" text-anchor="end">4,908</text>
  </g>

  <g class="fill-ink font-mono" font-size="12">
    <text x="98" y="76">camel</text>
    <text x="98" y="102">cat</text>
    <text x="98" y="128">catapult</text>
    <text x="98" y="200">kitten</text>
  </g>

  <!-- The rows nobody bothered to draw, and the distance they stand for. -->
  <g class="fill-ink-faint font-mono" font-size="12">
    <text x="86" y="152" text-anchor="end">·</text>
    <text x="86" y="164" text-anchor="end">·</text>
    <text x="86" y="176" text-anchor="end">·</text>
  </g>

  <!-- cat and catapult, side by side for no reason at all. -->
  <path
    class="fill-none stroke-accent"
    stroke-width="1.5"
    d="M172 90 H180 V132 H172"></path>
  <g class="fill-ink-muted font-mono" font-size="9">
    <text x="188" y="106">next door in the list</text>
    <text x="188" y="119">one of them is a siege engine</text>
  </g>

  <!-- cat and kitten, three thousand rows apart for no reason either. -->
  <g class="stroke-rule-strong" stroke-width="1.25" stroke-dasharray="3 3">
    <line x1="36" y1="98" x2="36" y2="196"></line>
  </g>
  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="31" y1="98" x2="41" y2="98"></line>
    <line x1="31" y1="196" x2="41" y2="196"></line>
  </g>
  <g class="fill-ink-muted font-mono" font-size="9">
    <text x="98" y="228">cat to kitten is 3,166 rows,</text>
    <text x="98" y="241">and the two of them mean nearly the same thing</text>
  </g>

  <!-- ============ the map ============ -->
  <rect
    x="366"
    y="52"
    width="248"
    height="176"
    rx="4"
    class="fill-paper-sunken stroke-rule"
    stroke-width="1"></rect>

  <!-- Close, because they keep the same company. -->
  <g class="stroke-accent" stroke-width="1.75">
    <line x1="430" y1="112" x2="462" y2="92"></line>
  </g>
  <text x="424" y="128" class="fill-ink-muted font-mono" font-size="9"
    >near</text
  >

  <!-- Far, because nothing about them is alike. -->
  <g class="stroke-rule-strong" stroke-width="1.25" stroke-dasharray="4 3">
    <line x1="430" y1="112" x2="576" y2="196"></line>
  </g>
  <text x="508" y="152" class="fill-ink-muted font-mono" font-size="9">far</text
  >

  <g class="fill-ink-muted">
    <circle cx="430" cy="112" r="3.5"></circle>
    <circle cx="462" cy="92" r="3.5"></circle>
    <circle cx="404" cy="140" r="3.5"></circle>
    <circle cx="576" cy="196" r="3.5"></circle>
  </g>

  <g class="fill-ink font-mono" font-size="11">
    <text x="430" y="104" text-anchor="middle">cat</text>
    <text x="462" y="84" text-anchor="middle">kitten</text>
    <text x="404" y="132" text-anchor="middle">dog</text>
    <text x="576" y="188" text-anchor="middle">catapult</text>
  </g>

  <g class="fill-ink-muted font-mono" font-size="9">
    <text x="366" y="252">nobody chose these two numbers</text>
    <text x="366" y="265">they came out of the company each word keeps</text>
  </g>
</svg>
