---
/**
 * One neuron with its numbers showing, using the scoring sheet from the unit's
 * opening — three points a year, ten for the degree, twenty for knowing the
 * panel, and a bar at sixty that becomes a bias of minus sixty.
 *
 * The arithmetic is deliberately checkable: 36 + 10 + 0 - 60 comes to -14, and
 * the bend turns that into nothing at all. Showing a total that the bend
 * actually acts on matters more than showing a tidy one — a diagram where the
 * bend passes its input through untouched teaches that the bend does nothing.
 *
 * Decorative on its own, so `aria-hidden`; `Figure` carries the name and the
 * description.
 */
---

<svg viewBox="0 0 640 210" class="w-full" aria-hidden="true">
  <!-- The three facts -->
  <text x="14" y="26" class="fill-ink-faint font-mono" font-size="9"
    >the facts it is given</text
  >
  <g class="stroke-rule" stroke-width="1">
    <rect x="14" y="36" width="112" height="26" rx="4" class="fill-paper"
    ></rect>
    <rect x="14" y="78" width="112" height="26" rx="4" class="fill-paper"
    ></rect>
    <rect x="14" y="120" width="112" height="26" rx="4" class="fill-paper"
    ></rect>
  </g>
  <g class="fill-ink font-mono" font-size="10">
    <text x="24" y="53">years 12</text>
    <text x="24" y="95">degree 1</text>
    <text x="24" y="137">panel 0</text>
  </g>

  <!-- One weight per fact -->
  <text x="150" y="26" class="fill-ink-faint font-mono" font-size="9"
    >one weight each</text
  >
  <g class="stroke-accent-2" stroke-width="1.25">
    <rect
      x="164"
      y="37"
      width="44"
      height="24"
      rx="4"
      class="fill-accent-2-soft"></rect>
    <rect
      x="164"
      y="79"
      width="44"
      height="24"
      rx="4"
      class="fill-accent-2-soft"></rect>
    <rect
      x="164"
      y="121"
      width="44"
      height="24"
      rx="4"
      class="fill-accent-2-soft"></rect>
  </g>
  <g class="fill-ink font-mono" font-size="10" text-anchor="middle">
    <text x="186" y="54">× 3</text>
    <text x="186" y="96">× 10</text>
    <text x="186" y="138">× 20</text>
  </g>

  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="130" y1="49" x2="160" y2="49"></line>
    <line x1="130" y1="91" x2="160" y2="91"></line>
    <line x1="130" y1="133" x2="160" y2="133"></line>
    <line x1="212" y1="49" x2="258" y2="80"></line>
    <line x1="212" y1="91" x2="258" y2="91"></line>
    <line x1="212" y1="133" x2="258" y2="102"></line>
  </g>

  <!-- The bias: a number that arrives whatever the facts say -->
  <rect
    x="164"
    y="163"
    width="44"
    height="24"
    rx="4"
    class="fill-paper stroke-rule"
    stroke-width="1"></rect>
  <text
    x="186"
    y="180"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="10">− 60</text
  >
  <text x="216" y="180" class="fill-ink-faint font-mono" font-size="9"
    >the bias, added whatever the facts say</text
  >
  <line
    x1="212"
    y1="175"
    x2="258"
    y2="112"
    class="stroke-rule-strong"
    stroke-width="1.25"></line>

  <!-- Add them up -->
  <rect
    x="260"
    y="66"
    width="66"
    height="60"
    rx="8"
    class="fill-paper-raised stroke-ink"
    stroke-width="1.5"></rect>
  <text
    x="293"
    y="101"
    text-anchor="middle"
    class="fill-ink font-display"
    font-size="12"
    font-weight="700">add up</text
  >

  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="330" y1="96" x2="352" y2="96"></line>
    <path d="M346 91 L354 96 L346 101" class="fill-none"></path>
  </g>

  <rect
    x="356"
    y="80"
    width="58"
    height="32"
    rx="4"
    class="fill-paper stroke-rule"
    stroke-width="1"></rect>
  <text
    x="385"
    y="101"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="11">− 14</text
  >

  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="418" y1="96" x2="440" y2="96"></line>
    <path d="M434 91 L442 96 L434 101" class="fill-none"></path>
  </g>

  <!-- The bend -->
  <text
    x="496"
    y="38"
    text-anchor="middle"
    class="fill-ink font-display"
    font-size="12"
    font-weight="700">the bend</text
  >
  <rect
    x="444"
    y="46"
    width="104"
    height="100"
    rx="8"
    class="fill-paper-raised stroke-accent"
    stroke-width="1.5"></rect>
  <g class="stroke-rule" stroke-width="1">
    <line x1="454" y1="128" x2="540" y2="128"></line>
    <line x1="492" y1="58" x2="492" y2="136"></line>
  </g>
  <path
    d="M454 128 L492 128 L534 86"
    class="fill-none stroke-accent"
    stroke-width="2"></path>
  <circle cx="492" cy="128" r="2.5" class="fill-accent"></circle>
  <text x="452" y="70" class="fill-ink-faint font-mono" font-size="8"
    >flat, then straight</text
  >

  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="552" y1="96" x2="572" y2="96"></line>
    <path d="M566 91 L574 96 L566 101" class="fill-none"></path>
  </g>

  <rect
    x="576"
    y="80"
    width="50"
    height="32"
    rx="4"
    class="fill-accent-soft stroke-accent"
    stroke-width="1.25"></rect>
  <text
    x="601"
    y="101"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="11">0</text
  >
  <text
    x="601"
    y="126"
    text-anchor="middle"
    class="fill-ink-faint font-mono"
    font-size="9">what it passes on</text
  >

  <text x="356" y="180" class="fill-ink font-mono" font-size="9"
    >the total fell below zero, so the bend sent nothing on</text
  >
  <text x="356" y="194" class="fill-ink-faint font-mono" font-size="9"
    >a total of +16 would have gone straight through, unchanged</text
  >
</svg>
