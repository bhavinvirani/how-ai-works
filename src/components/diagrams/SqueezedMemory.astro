---
/**
 * One fixed memory, asked to hold a four-word sentence and then a fourteen-word
 * one.
 *
 * The teaching load is carried by WIDTH, which is the one thing this diagram
 * can say that the paragraph above it cannot: the outer box is drawn at exactly
 * the same size in both rows, so a longer sentence visibly buys no extra room.
 * It only cuts the same room into thinner shares.
 *
 * The claim the whole picture is built around is an alignment, not a colour.
 * The width the first word holds on its own in the short sentence is the width
 * the first SIX words share in the long one; the bracket under row two is that
 * same width, and a dashed guide joins the two edges. The accent outline is a
 * secondary signal only — every highlighted strip also carries a label saying
 * what it is (hard rule 9).
 *
 * Shares decay geometrically with distance. That is the honest shape of what a
 * plain recurrent network does to an old word, not a measurement of any
 * particular model, and the unit says as much beside it.
 *
 * Every `<text>` sits inside a `<g>` that carries the styling, so no line runs
 * past 80 columns; Prettier reflows longer ones into a hanging-bracket shape
 * that is unreadable in a diagram this dense.
 *
 * Decorative on its own, so `aria-hidden`: `Figure` carries the accessible name
 * and the description.
 */
---

<svg viewBox="0 0 640 266" class="w-full" aria-hidden="true">
  <g class="fill-ink font-display" font-size="11" font-weight="700">
    <text x="16" y="60">a short sentence</text>
    <text x="16" y="156">a longer sentence</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="8">
    <text x="16" y="20">each strip is one word's share of the memory</text>
    <text x="16" y="74">4 words read</text>
    <text x="16" y="170">14 words read</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="7.5" text-anchor="middle">
    <text x="548.7" y="42">the word just read</text>
  </g>

  <!-- ================= row 1: a short sentence ================= -->
  <g class="fill-paper-sunken stroke-rule" stroke-width="1">
    <rect x="144" y="48" width="92.5" height="36"></rect>
    <rect x="236.5" y="48" width="108.8" height="36"></rect>
    <rect x="345.3" y="48" width="128" height="36"></rect>
    <rect x="473.3" y="48" width="150.7" height="36"></rect>
  </g>

  <g class="fill-ink-muted font-mono" font-size="9" text-anchor="middle">
    <text x="190.3" y="71">1</text>
    <text x="290.9" y="71">2</text>
    <text x="409.3" y="71">3</text>
    <text x="548.7" y="71">4</text>
  </g>

  <!-- The memory itself. Same width in both rows, and that is the point. -->
  <g class="fill-none stroke-rule-strong" stroke-width="1.25">
    <rect x="144" y="48" width="480" height="36"></rect>
    <rect x="144" y="144" width="480" height="36"></rect>
  </g>

  <!-- The first word, singled out in each row so widths can be compared. -->
  <rect
    x="144"
    y="48"
    width="92.5"
    height="36"
    class="fill-none stroke-accent"
    stroke-width="2"></rect>

  <line
    x1="190.3"
    y1="84"
    x2="190.3"
    y2="92"
    class="stroke-accent"
    stroke-width="1.25"></line>

  <g class="fill-ink font-mono" font-size="8" text-anchor="middle">
    <text x="190.3" y="104">the first word</text>
    <text x="190.3" y="115">about a fifth of the memory</text>
  </g>

  <!-- ================= row 2: a longer sentence ================= -->
  <line
    x1="148.9"
    y1="138"
    x2="148.9"
    y2="131"
    class="stroke-accent"
    stroke-width="1.25"></line>

  <g class="fill-accent font-mono" font-size="7.5">
    <text x="156" y="135">word 1, now a hairline</text>
  </g>

  <g class="fill-paper-sunken stroke-rule" stroke-width="1">
    <rect x="144" y="144" width="9.7" height="36"></rect>
    <rect x="153.7" y="144" width="11.4" height="36"></rect>
    <rect x="165.1" y="144" width="13.4" height="36"></rect>
    <rect x="178.5" y="144" width="15.8" height="36"></rect>
    <rect x="194.3" y="144" width="18.6" height="36"></rect>
    <rect x="212.9" y="144" width="21.9" height="36"></rect>
    <rect x="234.8" y="144" width="25.7" height="36"></rect>
    <rect x="260.5" y="144" width="30.3" height="36"></rect>
    <rect x="290.8" y="144" width="35.6" height="36"></rect>
    <rect x="326.4" y="144" width="41.9" height="36"></rect>
    <rect x="368.3" y="144" width="49.3" height="36"></rect>
    <rect x="417.6" y="144" width="58" height="36"></rect>
    <rect x="475.6" y="144" width="68.2" height="36"></rect>
    <rect x="543.8" y="144" width="80.2" height="36"></rect>
  </g>

  <g class="fill-ink-muted font-mono" font-size="9" text-anchor="middle">
    <text x="393" y="167">11</text>
    <text x="446.6" y="167">12</text>
    <text x="509.7" y="167">13</text>
    <text x="583.9" y="167">14</text>
  </g>

  <rect
    x="144"
    y="144"
    width="9.7"
    height="36"
    class="fill-none stroke-accent"
    stroke-width="1.75"></rect>

  <!-- The alignment that carries the lesson: one word's width up there, six
       words' width down here, joined by the dashed guide. -->
  <line
    x1="236"
    y1="120"
    x2="236"
    y2="192"
    class="stroke-rule-strong"
    stroke-width="1"
    stroke-dasharray="3 3"></line>

  <path
    d="M144 186 v6 H234.8 v-6"
    class="fill-none stroke-ink-muted"
    stroke-width="1.25"></path>

  <g class="fill-ink font-mono" font-size="8">
    <text x="144" y="208">the first six words together</text>
    <text x="144" y="219">fill the width word 1 had to itself above</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="8">
    <text x="16" y="246">The box is the same size in both rows. A longer</text>
    <text x="16" y="257">sentence buys no more room, only thinner shares.</text>
  </g>
</svg>
