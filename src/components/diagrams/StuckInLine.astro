---
/**
 * The same eight words, timed twice: once the way a recurrent network has to
 * take them, and once as they would go if no step needed the step before it.
 *
 * The teaching load is carried by the LENGTH OF THE TIME BAR and by the
 * presence or absence of arrows, never by colour. Top panel: seven boxes drawn
 * as dashed outlines with a bracket saying they are waiting, one solid box
 * labelled "working", arrows showing why, and a bar eight rounds long. Bottom
 * panel: the identical eight boxes, no arrows between them, and a bar one round
 * long starting at the same x. The two bars can be compared by eye because they
 * share a left edge and a scale.
 *
 * The bottom panel is deliberately labelled as a counterfactual — "if the steps
 * did not need each other" — because it is not something this method can do. It
 * is the shape of the bill, drawn so the reader can see what the sequential
 * version is paying.
 *
 * Every `<text>` sits inside a `<g>` that carries the styling, so no line runs
 * past 80 columns; Prettier reflows longer ones into a hanging-bracket shape
 * that is unreadable in a diagram this dense.
 *
 * Decorative on its own, so `aria-hidden`: `Figure` carries the accessible name
 * and the description.
 */
---

<svg viewBox="0 0 640 366" class="w-full" aria-hidden="true">
  <g class="fill-ink font-display" font-size="12" font-weight="700">
    <text x="16" y="24">Reading in order</text>
    <text x="16" y="222">If the steps did not need each other</text>
  </g>

  <g class="fill-ink-faint font-mono" font-size="8">
    <text x="16" y="38">a snapshot part-way through one sentence</text>
    <text x="16" y="136">time, in rounds of work</text>
    <text x="16" y="236">the same eight words, with nothing to wait for</text>
  </g>

  <!-- ========= panel 1: one word at a time, seven boxes idle ========= -->
  <rect
    x="32"
    y="52"
    width="54"
    height="28"
    rx="3"
    class="fill-accent-soft stroke-accent"
    stroke-width="1.75"></rect>

  <g
    class="fill-none stroke-rule-strong"
    stroke-width="1.25"
    stroke-dasharray="4 3"
  >
    <rect x="106" y="52" width="54" height="28" rx="3"></rect>
    <rect x="180" y="52" width="54" height="28" rx="3"></rect>
    <rect x="254" y="52" width="54" height="28" rx="3"></rect>
    <rect x="328" y="52" width="54" height="28" rx="3"></rect>
    <rect x="402" y="52" width="54" height="28" rx="3"></rect>
    <rect x="476" y="52" width="54" height="28" rx="3"></rect>
    <rect x="550" y="52" width="54" height="28" rx="3"></rect>
  </g>

  <!-- Each arrow is the dependency: nothing on its right can start yet. -->
  <g class="fill-none stroke-rule-strong" stroke-width="1.25">
    <line x1="88" y1="66" x2="104" y2="66"></line>
    <path d="M99 62 L104 66 L99 70"></path>
    <line x1="162" y1="66" x2="178" y2="66"></line>
    <path d="M173 62 L178 66 L173 70"></path>
    <line x1="236" y1="66" x2="252" y2="66"></line>
    <path d="M247 62 L252 66 L247 70"></path>
    <line x1="310" y1="66" x2="326" y2="66"></line>
    <path d="M321 62 L326 66 L321 70"></path>
    <line x1="384" y1="66" x2="400" y2="66"></line>
    <path d="M395 62 L400 66 L395 70"></path>
    <line x1="458" y1="66" x2="474" y2="66"></line>
    <path d="M469 62 L474 66 L469 70"></path>
    <line x1="532" y1="66" x2="548" y2="66"></line>
    <path d="M543 62 L548 66 L543 70"></path>
  </g>

  <g class="fill-ink font-mono" font-size="9" text-anchor="middle">
    <text x="59" y="70">w1</text>
  </g>

  <g class="fill-ink-muted font-mono" font-size="9" text-anchor="middle">
    <text x="133" y="70">w2</text>
    <text x="207" y="70">w3</text>
    <text x="281" y="70">w4</text>
    <text x="355" y="70">w5</text>
    <text x="429" y="70">w6</text>
    <text x="503" y="70">w7</text>
    <text x="577" y="70">w8</text>
  </g>

  <g class="fill-ink font-mono" font-size="7.5" text-anchor="middle">
    <text x="59" y="96">working</text>
  </g>

  <path
    d="M106 88 v6 H604 v-6"
    class="fill-none stroke-ink-muted"
    stroke-width="1.25"></path>

  <g class="fill-ink font-mono" font-size="8" text-anchor="middle">
    <text x="355" y="106">all waiting &mdash; each one needs</text>
    <text x="355" y="117">the summary from the box on its left</text>
  </g>

  <g class="fill-paper-sunken stroke-rule" stroke-width="1">
    <rect x="32" y="142" width="60" height="14"></rect>
    <rect x="92" y="142" width="60" height="14"></rect>
    <rect x="152" y="142" width="60" height="14"></rect>
    <rect x="212" y="142" width="60" height="14"></rect>
    <rect x="272" y="142" width="60" height="14"></rect>
    <rect x="332" y="142" width="60" height="14"></rect>
    <rect x="392" y="142" width="60" height="14"></rect>
    <rect x="452" y="142" width="60" height="14"></rect>
  </g>

  <g class="fill-ink-muted font-mono" font-size="7" text-anchor="middle">
    <text x="62" y="152">1</text>
    <text x="122" y="152">2</text>
    <text x="182" y="152">3</text>
    <text x="242" y="152">4</text>
    <text x="302" y="152">5</text>
    <text x="362" y="152">6</text>
    <text x="422" y="152">7</text>
    <text x="482" y="152">8</text>
  </g>

  <g class="fill-ink font-mono" font-size="9">
    <text x="520" y="153">8 rounds</text>
    <text x="100" y="327">1 round</text>
  </g>

  <g class="fill-ink font-display" font-size="11" font-weight="700">
    <text x="16" y="178">More processors do not make this bar shorter.</text>
    <text x="16" y="352">Same words, same chip. One round, not eight.</text>
  </g>

  <line x1="16" y1="196" x2="624" y2="196" class="stroke-rule" stroke-width="1"
  ></line>

  <!-- ========= panel 2: the same eight, nothing to wait for ========= -->
  <g class="fill-paper-sunken stroke-ink-muted" stroke-width="1.5">
    <rect x="32" y="250" width="54" height="28" rx="3"></rect>
    <rect x="106" y="250" width="54" height="28" rx="3"></rect>
    <rect x="180" y="250" width="54" height="28" rx="3"></rect>
    <rect x="254" y="250" width="54" height="28" rx="3"></rect>
    <rect x="328" y="250" width="54" height="28" rx="3"></rect>
    <rect x="402" y="250" width="54" height="28" rx="3"></rect>
    <rect x="476" y="250" width="54" height="28" rx="3"></rect>
    <rect x="550" y="250" width="54" height="28" rx="3"></rect>
  </g>

  <g class="fill-ink font-mono" font-size="9" text-anchor="middle">
    <text x="59" y="268">w1</text>
    <text x="133" y="268">w2</text>
    <text x="207" y="268">w3</text>
    <text x="281" y="268">w4</text>
    <text x="355" y="268">w5</text>
    <text x="429" y="268">w6</text>
    <text x="503" y="268">w7</text>
    <text x="577" y="268">w8</text>
  </g>

  <path
    d="M32 286 v6 H604 v-6"
    class="fill-none stroke-ink-muted"
    stroke-width="1.25"></path>

  <g class="fill-ink font-mono" font-size="8" text-anchor="middle">
    <text x="318" y="306">no arrows, so nothing waits</text>
  </g>

  <rect
    x="32"
    y="316"
    width="60"
    height="14"
    class="fill-paper-sunken stroke-rule"
    stroke-width="1"></rect>

  <g class="fill-ink-muted font-mono" font-size="7" text-anchor="middle">
    <text x="62" y="326">1</text>
  </g>
</svg>
