---
/**
 * The same two words — one long and ordinary, one short and rare — cut the
 * three ways anybody has ever proposed cutting text.
 *
 * The teaching load sits on the fact that all three rows are the same width.
 * Letters never fail and never end, words end but fail, and chunks do neither:
 * the familiar word collapses to three pieces the machine has met a million
 * times, the unfamiliar name spreads out to eight, and no box anywhere in the
 * bottom row is a question mark.
 *
 * The bottom row is what `TokenSplitter` produces for these two words, and its
 * lesson test pins both of them. Nothing is carried by colour: each row is
 * labelled, the piece counts are written out, and the one box that stands for
 * a failure is dashed and holds a question mark. Decorative on its own, so
 * `aria-hidden`: `Figure` supplies the accessible name and description.
 */

const CELL = 20;
const GAP = 2;
const boxWidth = (characters: number): number =>
  characters * CELL + (characters - 1) * GAP;

const LEFT = 16;
const RIGHT = 314;

const letterBoxes = (word: string, startX: number) =>
  Array.from(word, (character, index) => ({
    character,
    x: startX + index * (CELL + GAP),
  }));

const chunkBoxes = (chunks: readonly string[], startX: number) => {
  let x = startX;

  return chunks.map((chunk) => {
    const box = { chunk, x, width: boxWidth(chunk.length) };
    x += box.width + GAP;
    return box;
  });
};

const commonWord = 'understanding';
const rareName = 'Kowalczyk';

const rowOne = [
  ...letterBoxes(commonWord, LEFT),
  ...letterBoxes(rareName, RIGHT),
];

const rowThree = [
  ...chunkBoxes(['under', 'stand', 'ing'], LEFT),
  ...chunkBoxes(['K', 'o', 'w', 'al', 'c', 'z', 'y', 'k'], RIGHT),
];
---

<svg viewBox="0 0 640 224" class="w-full" aria-hidden="true">
  <!-- ============ one piece per letter ============ -->
  <text
    x="16"
    y="18"
    class="fill-ink font-display"
    font-size="12"
    font-weight="700">one piece per letter</text
  >

  {
    rowOne.map((box) => (
      <g>
        <rect
          x={box.x}
          y="26"
          width={CELL}
          height="24"
          rx="3"
          class="fill-paper-raised stroke-rule-strong"
          stroke-width="1"
        />
        <text
          x={box.x + CELL / 2}
          y="42"
          text-anchor="middle"
          class="fill-ink font-mono"
          font-size="11"
        >
          {box.character}
        </text>
      </g>
    ))
  }

  <text x="16" y="64" class="fill-ink-muted font-mono" font-size="9"
    >22 pieces. Nothing is ever unknown — and every sentence is now four times
    as long as it looked.</text
  >

  <!-- ============ one piece per word ============ -->
  <text
    x="16"
    y="92"
    class="fill-ink font-display"
    font-size="12"
    font-weight="700">one piece per word</text
  >

  <rect
    x="16"
    y="100"
    width="284"
    height="24"
    rx="3"
    class="fill-paper-raised stroke-rule-strong"
    stroke-width="1"></rect>
  <text
    x="158"
    y="116"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="11">understanding</text
  >

  <!-- The failure, drawn as a failure: dashed, and holding nothing. -->
  <rect
    x="314"
    y="100"
    width="196"
    height="24"
    rx="3"
    class="fill-paper-sunken stroke-rule-strong"
    stroke-width="1"
    stroke-dasharray="4 3"></rect>
  <text
    x="412"
    y="116"
    text-anchor="middle"
    class="fill-ink-muted font-mono"
    font-size="11">?</text
  >

  <text x="16" y="138" class="fill-ink-muted font-mono" font-size="9"
    >2 pieces, and one of them is a shrug. A name the list never met has nothing
    to look up.</text
  >

  <!-- ============ one piece per chunk ============ -->
  <text
    x="16"
    y="166"
    class="fill-ink font-display"
    font-size="12"
    font-weight="700">one piece per chunk — what actually happens</text
  >

  {
    rowThree.map((box) => (
      <g>
        <rect
          x={box.x}
          y="174"
          width={box.width}
          height="24"
          rx="3"
          class="fill-paper-raised stroke-accent"
          stroke-width="1.5"
        />
        <text
          x={box.x + box.width / 2}
          y="190"
          text-anchor="middle"
          class="fill-ink font-mono"
          font-size="11"
        >
          {box.chunk}
        </text>
      </g>
    ))
  }

  <text x="16" y="212" class="fill-ink-muted font-mono" font-size="9"
    >11 pieces. The long familiar word costs three; the short strange one costs
    eight; neither is a shrug.</text
  >
</svg>
