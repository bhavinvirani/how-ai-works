---
/**
 * The three-step cycle a learner runs when nobody can tell it the right answer:
 * try something, wait for a number, do more of whatever earned one.
 *
 * The teaching load sits on the empty box floating above the middle step. Every
 * other learning picture on this site has a correct answer somewhere in it — the
 * label on the example, the target the guess is compared against. Drawing that
 * slot and then leaving it empty, dashed, and disconnected is what makes this
 * loop legibly *different* rather than merely another row of boxes.
 *
 * Order is carried by the "step 1…3" captions and by left-to-right position;
 * absence is carried by the dashed outline AND by the words inside it. Colour
 * is never the only cue (hard rule 9). Decorative on its own, so `aria-hidden`:
 * `Figure` supplies the accessible name and the description.
 */

const STEPS = [
  {
    title: 'Try something',
    lines: [
      'pick one of the things',
      'you could do from here',
      'and actually do it',
    ],
  },
  {
    title: 'A number comes back',
    lines: [
      'the world reacts, and a',
      'score turns up afterwards',
      '— sometimes much later',
    ],
  },
  {
    title: 'Do more of that',
    lines: [
      'nudge the dials so choices',
      'that scored well get picked',
      'more often next time',
    ],
  },
];

const BOX = { width: 200, height: 96, top: 84, gap: 40 };

/** Left edge of the nth box. */
const left = (index: number) => 20 + index * (BOX.width + BOX.gap);
const centre = (index: number) => left(index) + BOX.width / 2;
const middle = BOX.top + BOX.height / 2;
const bottom = BOX.top + BOX.height;

/** Chevron pointing right, sitting in the gap after the nth box. */
const forwardHead = (index: number) => {
  const tip = left(index) + BOX.width + 26;
  return `M${String(tip - 8)} ${String(middle - 5)} L${String(tip)} ${String(middle)} L${String(tip - 8)} ${String(middle + 5)}`;
};

/** The long way back: down, left along the bottom, and up into the first box. */
const returnPath = `M${String(centre(2))} ${String(bottom + 8)} L${String(centre(2))} ${String(bottom + 32)} L${String(centre(0))} ${String(bottom + 32)} L${String(centre(0))} ${String(bottom + 8)}`;
const returnHead = `M${String(centre(0) - 5)} ${String(bottom + 14)} L${String(centre(0))} ${String(bottom + 6)} L${String(centre(0) + 5)} ${String(bottom + 14)}`;
---

<svg viewBox="0 0 720 250" class="w-full" aria-hidden="true">
  <!-- The slot every other learning diagram fills in, left empty on purpose. -->
  <rect
    x={left(1)}
    y="8"
    width={BOX.width}
    height="46"
    rx="6"
    class="fill-none stroke-rule"
    stroke-width="1.25"
    stroke-dasharray="4 4"></rect>
  <text
    x={centre(1)}
    y="27"
    text-anchor="middle"
    class="fill-ink-faint font-display"
    font-size="12"
    font-weight="700">the correct action</text
  >
  <text
    x={centre(1)}
    y="43"
    text-anchor="middle"
    class="fill-ink-faint font-mono"
    font-size="8">never supplied &mdash; nothing here knows one</text
  >

  <!-- A connector that starts and then simply stops before it arrives. -->
  <line
    x1={centre(1)}
    y1="56"
    x2={centre(1)}
    y2="70"
    class="stroke-rule"
    stroke-width="1.25"
    stroke-dasharray="3 4"></line>

  {
    STEPS.map((step, index) => (
      <g>
        <rect
          x={left(index)}
          y={BOX.top}
          width={BOX.width}
          height={BOX.height}
          rx="8"
          class="fill-paper stroke-rule-strong"
          stroke-width="1.25"
        />
        <text
          x={left(index) + 12}
          y={BOX.top + 20}
          class="fill-ink-faint font-mono"
          font-size="8"
        >
          step {index + 1} of 3
        </text>
        <text
          x={left(index) + 12}
          y={BOX.top + 41}
          class="fill-ink font-display"
          font-size="15"
          font-weight="700"
        >
          {step.title}
        </text>
        {step.lines.map((line, row) => (
          <text
            x={left(index) + 12}
            y={BOX.top + 62 + row * 13}
            class="fill-ink-muted font-mono"
            font-size="8.5"
          >
            {line}
          </text>
        ))}
      </g>
    ))
  }

  <!-- Forward arrows, box to box. -->
  <g class="stroke-rule-strong" stroke-width="1.75">
    {
      [0, 1].map((index) => (
        <g>
          <line
            x1={left(index) + BOX.width + 5}
            y1={middle}
            x2={left(index) + BOX.width + 24}
            y2={middle}
          />
          <path d={forwardHead(index)} class="fill-none" />
        </g>
      ))
    }
  </g>

  <!-- The return. Nothing new enters the loop on the way round — only the score. -->
  <g class="stroke-accent" stroke-width="2">
    <path d={returnPath} class="fill-none" stroke-linejoin="round"></path>
    <path d={returnHead} class="fill-none"></path>
  </g>

  <text
    x="360"
    y="238"
    text-anchor="middle"
    class="fill-accent font-display"
    font-size="13"
    font-weight="700"
    >and again, and again &mdash; the score is the only thing that ever comes
    back</text
  >
</svg>
