---
/**
 * The assembly drawing for the whole Part, and the unit's argument in one
 * picture: the search decides the contents of the box marked "everything the
 * model gets to see", and nothing to the right of that box can tell what is
 * missing from it.
 *
 * Three bands, in the order a system actually runs them:
 *
 *   1. the indexing pass, done once and again on edit — quiet, small, and
 *      drawn first so that "the store" is an object the reader has watched
 *      being built rather than a cloud the passages come out of;
 *   2. the question path, ending in three named cards and the count of what
 *      did not come back. Three out of 3,900 is the ceiling, drawn as a
 *      quantity rather than asserted as a claim;
 *   3. the enclosure. This is the load-bearing element. Saying "the passages
 *      are the model's whole world" is a sentence the reader can nod at and
 *      not believe; drawing a hard boundary with exactly five chips inside it
 *      — and the same passage numbers as band 2 — makes the absence of
 *      everything else a shape on the page.
 *
 * The citation is drawn as a dashed line running from the answer back to the
 * card it names, because an answer that can point at something is the property
 * that separates this route from baking documents into dials. It is dashed AND
 * labelled AND the reference is spelled out in text inside the answer box, so
 * it survives without colour.
 *
 * Nothing is carried by colour anywhere: the search is marked by a heavier
 * stroke, its own two-line label and its position in the chain; the model box
 * by its label; the retrieved passages by being numbered identically in both
 * bands.
 *
 * Every run of text is interpolated from a constant so that no `<text>` element
 * wraps across lines of markup — SVG strips newlines inside text content rather
 * than collapsing them to spaces, so a wrapped label silently loses its spaces.
 *
 * Decorative on its own, so `aria-hidden` — `Figure` carries the accessible
 * name and the plain-English description.
 */

const SAYS = {
  setupHead: 'Once, before anyone asks anything',
  setupSub: 'and again whenever one of the documents changes',

  documents: 'your documents',
  cut: 'cut into passages',
  position: 'a position on the map',
  stored: 'stored, ready to search',

  askHead: 'Every time somebody asks',
  askSub: 'and the third box decides everything after it',

  question: 'the question',
  questionPosition: 'a position on the map',
  search: 'the search',
  searchSub: 'the nearest passages win',
  searches: 'what it searches',

  cameBack: 'what came back',
  cameBackSub: 'and it is now the whole world',
  passage4: 'passage 4',
  passage17: 'passage 17',
  passage39: 'passage 39',
  count: 'three came back. 3,897 did not.',

  seesHead: 'Everything the model gets to see',
  seesSub: 'nothing after this point can tell that the wrong three arrived',

  instructions: 'instructions',
  nothingElse: 'and nothing else at all',
  onePass: 'one pass of the model',
  answer: 'the answer',
  reference: '[passage 17]',
  cite: 'the answer can point back at the passage it came from',
} as const;
