---
/**
 * The same run of the same system, scored in one place and then in two.
 *
 * This is `precision-and-recall`'s argument moved up a level, and it needs a
 * picture for the same reason that one did: the failure is not that the single
 * number is wrong, it is that the number is *correct and unusable*. Sixty-two
 * out of a hundred is an honest measurement of the finished answer, and there
 * is no operation you can perform on it to find out which of the two steps
 * spent the missing thirty-eight.
 *
 * The two rows are deliberately the same three boxes, in the same places, so
 * the only difference on the page is where the scores hang. Nothing about the
 * system changed; only where somebody chose to measure.
 *
 * The numbers multiply: 66 in a hundred find the right passage, 94 in a hundred
 * of those get written up correctly, and 0.66 × 0.94 is the 62 in the top row.
 * That is stated in the footer rather than left as a coincidence, because a
 * reader who checks it and finds it holds will trust the rest of the drawing.
 *
 * Every run of text is interpolated from a constant so that no `<text>` element
 * wraps across lines of markup: SVG strips newlines inside text content rather
 * than collapsing them to spaces, so a wrapped label silently loses its spaces.
 *
 * Decorative on its own, so `aria-hidden` — `Figure` carries the accessible
 * name and the plain-English description.
 */

const SAYS = {
  topHead: 'One score, at the end',
  topSub: 'what nearly every team measures',

  question: 'a question',
  find: 'find the passage',
  write: 'write the answer',
  answer: 'the answer',

  endScore: '62 of 100',

  topNote1: 'Which of the two steps spent the missing 38?',
  topNote2: 'Nothing in this row can say, and this row is what gets reported.',

  bottomHead: 'One score after each step',
  bottomSub: 'the same run, measured after each of the two steps',

  findScore: '66 of 100',
  findLabel: 'found the right passage',
  writeScore: '94 of 100',
  writeLabel: 'then wrote it up correctly',

  bottomNote1:
    'Sixty-six in a hundred, then ninety-four of those, is the 62 in the row above.',
  bottomNote2:
    'The writing was never the problem. The top row would have had you rewriting the prompt.',
} as const;
---

<svg viewBox="0 0 600 324" class="w-full" aria-hidden="true">
  <defs>
    <marker
      id="halves-arrow"
      viewBox="0 0 10 10"
      refX="9"
      refY="5"
      markerWidth="5"
      markerHeight="5"
      orient="auto"
    >
      <path d="M0,0 L10,5 L0,10 z" class="fill-ink-muted"></path>
    </marker>
  </defs>

  <!-- ── One score, at the end ────────────────────────────────── -->

  <text
    x="16"
    y="22"
    class="fill-ink font-display"
    font-size="13"
    font-weight="700">{SAYS.topHead}</text
  >
  <text x="16" y="38" class="fill-ink-muted" font-size="9.5">{SAYS.topSub}</text
  >

  <g class="fill-paper-sunken stroke-rule-strong" stroke-width="1.25">
    <rect x="16" y="54" width="112" height="32" rx="6"></rect>
    <rect x="144" y="54" width="144" height="32" rx="6"></rect>
    <rect x="304" y="54" width="144" height="32" rx="6"></rect>
    <rect x="464" y="54" width="120" height="32" rx="6"></rect>
  </g>

  <g class="fill-ink" font-size="9.5" text-anchor="middle">
    <text x="72" y="74">{SAYS.question}</text>
    <text x="216" y="74">{SAYS.find}</text>
    <text x="376" y="74">{SAYS.write}</text>
    <text x="524" y="74">{SAYS.answer}</text>
  </g>

  <g
    class="stroke-ink-muted"
    stroke-width="1.25"
    marker-end="url(#halves-arrow)"
  >
    <line x1="128" y1="70" x2="140" y2="70"></line>
    <line x1="288" y1="70" x2="300" y2="70"></line>
    <line x1="448" y1="70" x2="460" y2="70"></line>
  </g>

  <line
    x1="524"
    y1="86"
    x2="524"
    y2="94"
    class="stroke-rule-strong"
    stroke-width="1.25"></line>
  <rect
    x="464"
    y="94"
    width="120"
    height="26"
    rx="5"
    class="fill-accent-soft stroke-accent"
    stroke-width="1.25"></rect>
  <text
    x="524"
    y="111"
    text-anchor="middle"
    class="fill-ink font-mono"
    font-size="10">{SAYS.endScore}</text
  >

  <text x="16" y="105" class="fill-ink" font-size="9.5" font-weight="700"
    >{SAYS.topNote1}</text
  >
  <text x="16" y="121" class="fill-ink-muted" font-size="9.5"
    >{SAYS.topNote2}</text
  >

  <line x1="12" y1="140" x2="588" y2="140" class="stroke-rule" stroke-width="1"
  ></line>

  <!-- ── One score after each step ────────────────────────────── -->

  <text
    x="16"
    y="164"
    class="fill-ink font-display"
    font-size="13"
    font-weight="700">{SAYS.bottomHead}</text
  >
  <text x="16" y="180" class="fill-ink-muted" font-size="9.5"
    >{SAYS.bottomSub}</text
  >

  <g class="fill-paper-sunken stroke-rule-strong" stroke-width="1.25">
    <rect x="16" y="196" width="112" height="32" rx="6"></rect>
    <rect x="144" y="196" width="144" height="32" rx="6"></rect>
    <rect x="304" y="196" width="144" height="32" rx="6"></rect>
    <rect x="464" y="196" width="120" height="32" rx="6"></rect>
  </g>

  <g class="fill-ink" font-size="9.5" text-anchor="middle">
    <text x="72" y="216">{SAYS.question}</text>
    <text x="216" y="216">{SAYS.find}</text>
    <text x="376" y="216">{SAYS.write}</text>
    <text x="524" y="216">{SAYS.answer}</text>
  </g>

  <g
    class="stroke-ink-muted"
    stroke-width="1.25"
    marker-end="url(#halves-arrow)"
  >
    <line x1="128" y1="212" x2="140" y2="212"></line>
    <line x1="288" y1="212" x2="300" y2="212"></line>
    <line x1="448" y1="212" x2="460" y2="212"></line>
  </g>

  <g class="stroke-rule-strong" stroke-width="1.25">
    <line x1="216" y1="228" x2="216" y2="236"></line>
    <line x1="376" y1="228" x2="376" y2="236"></line>
  </g>

  <g class="fill-accent-soft stroke-accent" stroke-width="1.25">
    <rect x="144" y="236" width="144" height="34" rx="5"></rect>
    <rect x="304" y="236" width="144" height="34" rx="5"></rect>
  </g>

  <g class="fill-ink font-mono" font-size="10" text-anchor="middle">
    <text x="216" y="252">{SAYS.findScore}</text>
    <text x="376" y="252">{SAYS.writeScore}</text>
  </g>

  <g class="fill-ink-muted" font-size="8" text-anchor="middle">
    <text x="216" y="264">{SAYS.findLabel}</text>
    <text x="376" y="264">{SAYS.writeLabel}</text>
  </g>

  <line x1="12" y1="284" x2="588" y2="284" class="stroke-rule" stroke-width="1"
  ></line>

  <text x="16" y="302" class="fill-ink" font-size="9.5" font-weight="700"
    >{SAYS.bottomNote1}</text
  >
  <text x="16" y="316" class="fill-ink-muted" font-size="9.5"
    >{SAYS.bottomNote2}</text
  >
</svg>
