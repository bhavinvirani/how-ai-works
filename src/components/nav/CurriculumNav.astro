---
import { ui } from '../../copy/en';
import { PART_LABELS, PARTS } from '../../lib/units/parts';
import { unitHref } from '../../lib/units/resolve';

/**
 * The generated sidebar (PLAN §8, slice `2-nav`).
 *
 * Every entry comes from unit frontmatter — Part, order, title — so the running
 * order is data rather than a hand-maintained list that quietly disagrees with
 * the content. Adding a unit adds a nav entry; nothing here is edited when a
 * Part lands.
 *
 * Parts with no published units are dropped rather than shown empty, which is
 * what makes this safe to ship after the FIRST Part instead of the last: a
 * reader never meets sixteen headings with nothing under fourteen of them.
 *
 * Rendered twice by the unit page, once per `variant`, and each copy is hidden
 * at the other breakpoint. Only one is ever in the accessibility tree, because
 * the hidden one is `display: none` — the same approach `InstrumentPanel` takes
 * with its small-screen fallback.
 *
 * Zero JavaScript: `<details>` does the disclosure and `aria-current` does the
 * highlight, so a lesson page still ships nothing to hydrate.
 */

export interface NavUnit {
  id: string;
  title: string;
  part: string;
  order: number;
}

interface Props {
  units: NavUnit[];
  /** `rail` sits beside the lesson at `lg`+; `compact` folds above it below that. */
  variant: 'rail' | 'compact';
  /** The unit being read, so it can be marked. Omit on non-unit pages. */
  currentId?: string;
}

const { units, variant, currentId } = Astro.props;
const base = import.meta.env.BASE_URL;

/** Grouped and ordered by frontmatter, in the Part order the enum declares. */
const groups = PARTS.map((part) => ({
  part,
  label: PART_LABELS[part],
  units: units
    .filter((unit) => unit.part === part)
    .sort((a, b) => a.order - b.order),
})).filter((group) => group.units.length > 0);

const LINK =
  'text-sm leading-snug text-ink-muted hover:text-ink aria-[current=page]:font-medium aria-[current=page]:text-accent';
---

{
  groups.length > 0 &&
    (variant === 'rail' ? (
      <nav
        aria-label={ui.nav.label}
        class="sticky top-0 max-h-dvh overflow-y-auto py-16"
      >
        {groups.map((group) => (
          <div class="mb-5">
            <p class="font-mono text-2xs tracking-wide text-ink-faint uppercase">
              {group.label}
            </p>
            <ul class="mt-1.5 flex flex-col gap-1">
              {group.units.map((unit) => (
                <li>
                  <a
                    href={unitHref(base, unit.id)}
                    aria-current={unit.id === currentId ? 'page' : undefined}
                    class={LINK}
                  >
                    {unit.title}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </nav>
    ) : (
      <details class="mb-10 border-b border-rule pb-4">
        <summary class="cursor-pointer list-none font-mono text-2xs tracking-wide text-ink-faint uppercase">
          {ui.nav.contents}
        </summary>
        <nav aria-label={ui.nav.label} class="mt-3">
          {groups.map((group) => (
            <div class="mb-4">
              <p class="font-mono text-2xs tracking-wide text-ink-faint uppercase">
                {group.label}
              </p>
              <ul class="mt-1.5 flex flex-col gap-1">
                {group.units.map((unit) => (
                  <li>
                    <a
                      href={unitHref(base, unit.id)}
                      aria-current={unit.id === currentId ? 'page' : undefined}
                      class={LINK}
                    >
                      {unit.title}
                    </a>
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </nav>
      </details>
    ))
}
