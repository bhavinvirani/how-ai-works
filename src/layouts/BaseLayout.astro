---
/**
 * The one page shell.
 *
 * These four stylesheet imports are deliberately here rather than inside
 * global.css. Importing them from frontmatter routes the font and KaTeX woff2
 * files through Vite's asset pipeline, which rewrites their url() references to
 * base-path-aware hashed URLs. A bare-specifier @import in CSS is the version
 * that looks right in dev and 404s under /how-ai-works/.
 *
 * No user-facing English lives in this file (CLAUDE.md hard rule 10) — every
 * string a reader sees arrives as a prop from MDX frontmatter.
 */
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/public-sans';
import '@fontsource-variable/jetbrains-mono';
import 'katex/dist/katex.min.css';
import '../styles/global.css';

import SiteHeader from '../components/nav/SiteHeader.astro';
import SeoHead from '../components/seo/SeoHead.astro';
import type { SchemaNode } from '../lib/seo/schema';
import { site } from '../seo/site';

/**
 * Everything a page can tell a crawler about itself beyond its title and
 * description. Optional throughout: a page that says nothing here gets an
 * indexable `website` with the shared social card, which is right for all but
 * the lessons and the utility pages.
 */
interface SeoOptions {
  type?: 'website' | 'article';
  noindex?: boolean;
  modified?: Date;
  image?: string;
  imageAlt?: string;
  jsonLd?: SchemaNode[];
}

interface PageMeta {
  title: string;
  description: string;
  seo?: SeoOptions;
}

/**
 * An MDX page using `layout:` receives its frontmatter under a `frontmatter`
 * prop; an .astro page passes the same fields directly. Accept both so pages
 * can be written in either format.
 */
interface Props extends Partial<PageMeta> {
  frontmatter?: PageMeta;
  /**
   * Marks this page's `<main>` as the part Pagefind should index.
   *
   * Opt-in rather than automatic, because once ANY page on the site carries
   * `data-pagefind-body`, Pagefind indexes only pages that carry it — so the
   * attribute silently decides what is searchable site-wide. Lessons are the
   * content; `/gallery`, `/progress` and `/map` are furniture, and having them
   * compete with lessons in the results would make search worse, not better.
   *
   * It sits on the existing `<main>` rather than on a wrapper element on
   * purpose: `.content > *` in global.css uses direct child combinators, so
   * introducing a wrapper would silently break the prose spacing on all sixty
   * unit pages while every gate stayed green.
   */
  searchable?: boolean;
}

const { frontmatter, searchable, ...direct } = Astro.props;
const { title, description, seo } = frontmatter ?? (direct as PageMeta);

/**
 * Whether to load the visit counter.
 *
 * Opt-in through an environment variable that ONLY `deploy.yml` sets, rather
 * than the `import.meta.env.PROD` check that suggests itself. `PROD` is true
 * for every `astro build`, which includes the one the e2e suite runs against —
 * so the obvious version puts a third-party request from `gc.zgo.at` into every
 * CI run on every push. That is a network dependency in a suite that has none,
 * and `smoke.spec.ts` fails the build on any response ≥ 400, which would hand
 * GoatCounter's uptime a veto over ours.
 *
 * The cost of this choice is that the counter is one unset variable away from
 * silently never running. `docs/SEO.md` carries the check for it, and the
 * e2e suite asserts the script is absent from a normal build so that the two
 * halves of the switch cannot both quietly become false.
 */
const analyticsEnabled = Boolean(process.env.ENABLE_ANALYTICS);

/**
 * Pages that supply a `nav` slot get a two-column shell; everything else keeps
 * the single centred column. Checked rather than passed as a prop so a page
 * cannot claim to have navigation and then not render any.
 */
const hasNav = Astro.slots.has('nav');
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <SeoHead title={title} description={description} {...seo ?? {}} />
    <meta name="generator" content={Astro.generator} />
  </head>
  <body class="min-h-dvh">
    {
      /*
      Outside `<main>` on purpose, and outside both branches below, so it is on
      every page exactly once. It must not go inside `<main class="content">`:
      that element's rules in global.css use direct child combinators
      (`.content > *`), so anything added there shifts the prose spacing on all
      sixty lesson pages.
    */
    }
    <SiteHeader pathname={Astro.url.pathname} />

    {
      hasNav ? (
        <div class="mx-auto flex max-w-6xl gap-12 px-6">
          <div class="w-56 shrink-0 max-lg:hidden">
            <slot name="nav" />
          </div>
          <main
            class="content max-w-3xl min-w-0 flex-1 py-16"
            data-pagefind-body={searchable ? true : undefined}
          >
            {/* The disclosure copy of the nav rides above the lesson on small
                screens, where the rail is hidden. */}
            <div class="lg:hidden">
              <slot name="nav-compact" />
            </div>
            <slot />
          </main>
        </div>
      ) : (
        <main
          class="content mx-auto max-w-3xl px-6 py-16"
          data-pagefind-body={searchable ? true : undefined}
        >
          <slot />
        </main>
      )
    }

    {
      /*
      GoatCounter: a cookieless visit count. It stores nothing on the reader's
      device, sets no identifier, and sends a page path, a referrer and a coarse
      browser and country — which is why the site needs no consent banner and
      why /progress can still say your progress never leaves the browser. It
      does not, and this does not carry it.

      `is:inline` is required rather than stylistic: without it Astro takes
      ownership of the tag, bundles it, and drops the `data-goatcounter`
      attribute the script reads its own configuration from.

      Loaded last and `async`, so it cannot delay anything a reader is waiting
      for. GoatCounter's own script declines to count localhost, so a local
      production build with the variable set will load it and record nothing.
    */
    }
    {
      analyticsEnabled && (
        <script
          is:inline
          async
          data-goatcounter={site.analytics.goatcounter}
          src="https://gc.zgo.at/count.js"
        />
      )
    }
  </body>
</html>
