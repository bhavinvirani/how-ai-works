---
import { getCollection, render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';

import ConnectionsFooter from '../../components/blocks/ConnectionsFooter.astro';
import { UnitProgress } from '../../components/blocks/UnitProgress';
import CurriculumNav from '../../components/nav/CurriculumNav.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { assertAcyclic } from '../../lib/units/graph';
import { assertInteractivesExist } from '../../lib/units/interactives';
import {
  resolveConnections,
  resolvePrerequisites,
} from '../../lib/units/resolve';

/**
 * Every unit page.
 *
 * This is also where the prerequisite graph is checked. Zod validates that each
 * reference points at a unit that exists; it cannot see the shape of the
 * resulting graph, and both the reading order and `/map` assume a DAG. Running
 * the check here means a cycle fails `astro build` rather than surfacing later
 * as a nonsensical reading order.
 */
export async function getStaticPaths() {
  const units = await getCollection('units');

  assertAcyclic(
    units.map((unit) => ({
      id: unit.id,
      prerequisites: unit.data.prerequisites.map((reference) => reference.id),
      part: unit.data.part,
      order: unit.data.order,
    })),
  );

  // `interactives[]` is a list of plain strings, so Zod cannot tell a real
  // component from a typo. Checked here rather than post-build so a wrong name
  // fails `astro build` alongside every other content mistake.
  assertInteractivesExist(
    units.map((unit) => ({
      id: unit.id,
      interactives: unit.data.interactives,
    })),
  );

  // Drafts are visible while writing, never in a deployed build.
  const visible = units.filter(
    (unit) => unit.data.status === 'published' || import.meta.env.DEV,
  );

  // `visible`, not `units` — and this is load-bearing rather than tidy. The
  // page below builds its lookup table from this prop, so passing the full
  // collection would let a published unit resolve a *draft* it connects to and
  // emit a link to `/units/<draft>` — a page this very function just declined
  // to generate. That ships as a broken internal link caught by lychee, not as
  // the Zod reference error it looks like. Passing the filtered list is what
  // makes `resolve.ts`'s documented "drop anything missing" behaviour real.
  return visible.map((unit) => ({
    params: { slug: unit.id },
    props: { unit, units: visible },
  }));
}

interface Props {
  unit: CollectionEntry<'units'>;
  units: CollectionEntry<'units'>[];
}

const { unit, units } = Astro.props;
const { Content } = await render(unit);

const byId = new Map(units.map((entry) => [entry.id, entry]));
const base = import.meta.env.BASE_URL;

const prerequisites = resolvePrerequisites(
  unit.data.prerequisites,
  (id) => {
    const entry = byId.get(id);
    return entry && { title: entry.data.title, summary: entry.data.summary };
  },
  base,
);

const connections = resolveConnections(
  unit.data.connections,
  (id) => byId.get(id)?.data.title,
  base,
);

// The sidebar is generated from the same filtered list the routes came from, so
// it can never offer a link to a page that was not built.
const navUnits = units.map((entry) => ({
  id: entry.id,
  title: entry.data.title,
  part: entry.data.part,
  order: entry.data.order,
}));
---

{
  /* `searchable` makes this the only kind of page Pagefind indexes — the
    lessons, not the gallery, the progress page or the map. See BaseLayout. */
}
<BaseLayout title={unit.data.title} description={unit.data.summary} searchable>
  <CurriculumNav
    slot="nav"
    variant="rail"
    units={navUnits}
    currentId={unit.id}
  />
  <CurriculumNav
    slot="nav-compact"
    variant="compact"
    units={navUnits}
    currentId={unit.id}
  />

  <h1>{unit.data.title}</h1>
  <Content />
  <UnitProgress client:visible unitId={unit.id} />
  <ConnectionsFooter prerequisites={prerequisites} connections={connections} />
</BaseLayout>
